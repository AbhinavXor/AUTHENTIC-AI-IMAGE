APP_ENVIRONMENT=development

GROQ_API_KEY=
GROQ_QUALITY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45

FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAXIMUM_HISTORY_MESSAGES=16

# Artifact lifecycle
ARTIFACT_STORAGE_DIRECTORY=
ARTIFACT_RETENTION_HOURS=24
ARTIFACT_CLEANUP_INTERVAL_SECONDS=900
# Large-document pipeline: accepts up to 2,000,000 source characters,
# composes in bounded chunks, and automatically bundles extreme PDF
# requests into 2-4 numbered PDF volumes inside one ZIP archive.
ARTIFACT_MAXIMUM_REQUEST_BYTES=25165824
ARTIFACT_MAXIMUM_PROMPT_CHARACTERS=2000000
ARTIFACT_LARGE_SOURCE_CHUNK_CHARACTERS=9000
ARTIFACT_PDF_BUNDLE_SOURCE_CHARACTERS=260000
ARTIFACT_MAXIMUM_PDF_BUNDLE_VOLUMES=4
ARTIFACT_MAXIMUM_CONTENT_CHARACTERS=2000000
ARTIFACT_MAXIMUM_GENERATED_FILE_BYTES=209715200
ARTIFACT_OPERATION_RATE_LIMIT_REQUESTS=120
ARTIFACT_OPERATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Background artifact jobs
ARTIFACT_JOB_STORAGE_DIRECTORY=
ARTIFACT_JOB_RETENTION_HOURS=24
ARTIFACT_JOB_MAXIMUM_QUEUED_JOBS=20
ARTIFACT_JOB_RATE_LIMIT_REQUESTS=30
ARTIFACT_JOB_RATE_LIMIT_WINDOW_SECONDS=3600
ARTIFACT_JOB_MAXIMUM_CONCURRENT_JOBS=2
ARTIFACT_JOB_ACCESS_TOKEN_BYTES=32
ARTIFACT_JOB_MAXIMUM_ERROR_CHARACTERS=1000
